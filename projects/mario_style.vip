# mario_style.vip
#
# Bright major-key platformer pastiche — the kind of bouncy syncopated
# thing you'd get if you asked "write something that feels like an NES
# side-scroller overworld" without lifting any actual melody.
#
# Not a transcription. Uses the vocabulary (parallel thirds on PU1+PU2,
# octave-jumping TRI bass, light noise drums, I–IV–V harmony) but the
# notes are original.
#
# Load: :e projects/mario_style.vip
# Play: <space>

@meta  title="overworld pastiche"  style="NES platformer"  key="C major"

@song  bpm=150  edit_step=1  current=00  order=[00]  loop=00

# Instruments
@instr 00  a=2   d=60   s=0.70  r=80   duty=0.50  vol=0.80   # lead pulse
@instr 01  a=2   d=40   s=0.50  r=60   duty=0.25  vol=0.55   # harmony pulse (thin)
@instr 02  a=2   d=30   s=0.90  r=120  duty=0.50  vol=0.90   # triangle bass
@instr 03  a=0   d=40   s=0.00  r=30   duty=0.50  vol=0.60   # noise drum

# Phrase 00 — main loop, I–V–IV–V in C major.
# PU1 leads, PU2 harmonizes a 3rd/6th below, TRI does the classic
# chiptune octave-jump bass, NOI is kick on 1 & 3 and hat on the &s.
@phrase 00
  # step   PU1        PU2         TRI         NOI
  00       E-5        C-5:01      C-3:02      G-2:03
  01       E-5        C-5:01      C-4:02      ---
  02       G-5        E-5:01      C-3:02      C-3:03
  03       E-5        C-5:01      C-4:02      ---
  04       C-6        G-5:01      G-2:02      G-2:03
  05       G-5        E-5:01      G-3:02      ---
  06       A-5        F-5:01      G-2:02      C-3:03
  07       F-5        D-5:01      G-3:02      ---
  08       G-5        E-5:01      F-2:02      G-2:03
  09       ---        ---         F-3:02      ---
  0a       A-5        F-5:01      F-2:02      C-3:03
  0b       B-5        G-5:01      F-3:02      ---
  0c       C-6        G-5:01      G-2:02      G-2:03
  0d       B-5        G-5:01      G-3:02      ---
  0e       A-5        F-5:01      G-2:02      C-3:03
  0f       G-5        E-5:01      G-3:02      ---
